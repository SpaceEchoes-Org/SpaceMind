    {
      "id": "mars_pathfinder_001",
      "entity": "Mars Pathfinder",
      "category": "mission_overview",
      "celestial_body": "Mars",
      "content": "Mars Pathfinder was a NASA mission that landed on Mars on July 4, 1997. It included the Carl Sagan Memorial Station lander and the Sojourner rover. Its goals included testing a low-cost landing system and studying the Martian atmosphere, weather, and geology. The last transmission was received on September 27, 1997.",
      "source": "NASA Science - Mars Pathfinder",
      "source_url": "https://science.nasa.gov/mission/mars-pathfinder/",
      "verification_status": "user_provided_pending_independent_review",
      "language": "en",
      "tags": [
        "Mars",
        "Pathfinder",
        "Sojourner",
        "lander",
        "rover"
      ],
      "record_id": "mars_pathfinder_001",
      "record_type": "overview",
      "origin_file": "knowledge_base.json"
    },
    {
      "id": "insight_001",
      "entity": "InSight Lander",
      "category": "mission_overview",
      "celestial_body": "Mars",
      "content": "NASA's InSight lander touched down on Mars on November 26, 2018, at Elysium Planitia. Its mission was to study the planet's interior, including its crust, mantle, and core. It recorded more than 1,300 marsquakes. The mission ended in December 2022.",
      "source": "NASA Science - InSight",
      "source_url": "https://science.nasa.gov/mission/insight/",
