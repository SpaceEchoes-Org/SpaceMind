    {
      "id": "lrv_001",
      "entity": "Lunar Roving Vehicle",
      "category": "vehicle",
      "celestial_body": "Moon",
      "content": "The Lunar Roving Vehicle was a four-wheeled electric vehicle used by astronauts during Apollo 15, Apollo 16, and Apollo 17. It helped astronauts travel across the lunar surface and collect scientific samples and observations. It was first used during Apollo 15 in July 1971.",
      "source": "NASA NSSDCA - Apollo Lunar Roving Vehicle",
      "source_url": "https://nssdc.gsfc.nasa.gov/planetary/lunar/apollo_lrv.html",
