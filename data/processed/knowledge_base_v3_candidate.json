    {
      "id": "apollo15_alsep_001",
      "entity": "Apollo 15 ALSEP",
      "category": "scientific_instruments",
      "celestial_body": "Moon",
      "content": "The Apollo 15 ALSEP was a group of scientific experiments deployed on the lunar surface during the Apollo 15 mission. Its seven experiments studied seismic activity, magnetic fields, solar wind, ions, heat flow, the lunar atmosphere, and dust-related effects. The ALSEP network was shut down on September 30, 1977.",
      "source": "NASA Apollo 15 Press Kit",
      "source_url": "https://www.nasa.gov/wp-content/uploads/static/apollo50th/pdf/A15_PressKit.pdf",
      "verification_status": "user_provided_pending_independent_review",
